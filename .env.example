# =====================================================================
# CONFIGURAÇÃO DE SEGURANÇA E AMBIENTE - PAINEL TI GNU
# Importante: NUNCA envie o arquivo .env preenchido para o controle de versão (Git).
# Copie este arquivo para .env e preencha com as credenciais reais da sua infraestrutura.
# =====================================================================

# --- BANCO DE DADOS (POSTGRESQL) ---
DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/painel_montagem

# --- SERVIDOR HTTP ---
PORT=3000
NODE_ENV=development

# --- CHAVE DE ASSINATURA JWT ---
# Segredo longo e aleatório usado para assinar os tokens de sessão dos usuários.
JWT_SECRET=troque-por-um-segredo-aleatorio-longo-e-seguro

# --- CREDENCIAIS DE ACESSO INICIAIS ---
# Definidas na primeira inicialização do banco para criar os usuários padrão.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha-admin-segura
VIEWER_USER=viewer
VIEWER_PASSWORD=troque-esta-senha-viewer-segura

# --- INTEGRAÇÃO COM GLPI (API REST) ---
# URL da API REST do GLPI (ex: http://seuservidor/glpi/apirest.php ou http://192.168.1.100/apirest.php)
GLPI_API_URL=http://seu-servidor-glpi/apirest.php

# Token da Aplicação registrado no GLPI (Setup > API > App Token)
GLPI_APP_TOKEN=seu_app_token_glpi_aqui

# Token de Usuário da conta de serviço GLPI (User > Settings > Remote authentication keys)
GLPI_USER_TOKEN=seu_user_token_glpi_aqui

# ID da Entidade no GLPI (Padrão: 1 para GNU > TI)
GLPI_ENTITY_ID=1

# URL base da interface web do GLPI (para links diretos de chamados)
GLPI_WEB_URL=http://seu-servidor-glpi
